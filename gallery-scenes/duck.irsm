// A rubber duck drifting through bathwater, with a few soap bubbles.
// Faces +X. The water's surface is at y = 0.

light(0.9, 1.5, 1.0, 1.1)

// ── Backdrop and water ─────────────────────────────────
// The hole on the light's side stops the shell from shadowing the scene.
material(neon, paint(#3A6A70, difference(difference(sphere(34), sphere(33.6)), move(15, 25, 16.7, sphere(22)))))
material(plastic, paint(#58B4C4, move(0, -0.2, 0, cylinder(30, 0.4))))
paint(#8ED2DA, move(0, 0.01, 0, torus(5.6, 0.07)), move(0, 0.01, 0, torus(7.4, 0.06)), move(0, 0.01, 0, torus(9.5, 0.05)))

// ── Duck ───────────────────────────────────────────────

body = move(0, 1.1, 0, scale(3.1, 1.85, 2.2, sphere(1)))
tail = move(-2.85, 2.25, 0, rotateZ(38, scale(0.85, 0.32, 0.65, sphere(1))))
chest = move(1.55, 1.5, 0, sphere(1.5))
wing = scale(1.35, 0.72, 0.28, sphere(1))
head = move(1.65, 4.05, 0, sphere(1.5))
neck = move(1.45, 2.8, 0, cylinder(0.95, 1.2))
material(plastic, paint(#FFC91F, body, tail, chest, neck, head,
         move(-0.4, 1.75, 2.08, rotateZ(-14, wing)), move(-0.4, 1.75, -2.08, rotateZ(-14, wing))))

// Beak: two flattened halves, slightly open
upperBeak = move(3.1, 3.95, 0, scale(0.95, 0.24, 0.72, sphere(1)))
lowerBeak = move(2.95, 3.68, 0, rotateZ(8, scale(0.75, 0.16, 0.55, sphere(1))))
material(plastic, paint(#F46A12, upperBeak, lowerBeak))

// Eyes
eyeWhite = sphere(0.36)
pupil = sphere(0.22)
material(plastic, paint(#FFFFFF, move(2.55, 4.6, 0.82, eyeWhite), move(2.55, 4.6, -0.82, eyeWhite)))
material(plastic, paint(#16181C, move(2.8, 4.63, 0.88, pupil), move(2.8, 4.63, -0.88, pupil)))

// ── Soap bubbles ───────────────────────────────────────
material(plastic, paint(#EAF8FA,
    move(4.8, 0.5, 3.5, sphere(0.65)), move(5.9, 0.3, 2.6, sphere(0.34)), move(-3.8, 0.55, 3.6, sphere(0.7)),
    move(-4.8, 0.35, 2.8, sphere(0.4)), move(4.2, 0.4, -4.2, sphere(0.5)), move(-3.5, 6.4, -2.2, sphere(0.42)), move(6.4, 4.2, -2.6, sphere(0.3))))
