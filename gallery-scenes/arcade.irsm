// An arcade cabinet glowing in a dark room, with a pixel-art anvil on the screen.
// Faces +X, standing on a chequered floor at y = 0.

light(1, 1.6, 1.1, 0.55)

// A dark room: the hole on the light's side stops the shell shadowing the scene.
material(neon, paint(#010104, difference(difference(sphere(34), sphere(33.6)), move(15.2, 24.3, 16.7, sphere(22)))))

// ── Chequered floor ────────────────────────────────────
tile = repeat(4, 0, 4, cube(2, 1, 2))
paint(#20242C, move(0, -0.15, 0, cylinder(12, 0.3)))
paint(#AEB4BC, move(0, -0.14, 0, intersection(cylinder(12, 0.31), group(move(1, 0, 1, tile), move(3, 0, 3, tile)))))

// ── Cabinet body ───────────────────────────────────────
slant = move(2.25, 5.5, 0, rotateZ(20, cube(2, 3.4, 1)))
side = move(0, 3.8, 0, difference(cube(3.8, 7.6, 0.2), move(0, -3.8, 0, slant)))
material(plastic, paint(#2A1B4A, move(-0.45, 3.8, 0, cube(2.6, 7.6, 2.6))))
material(plastic, paint(#E2591D, move(0, 0, 1.4, side), move(0, 0, -1.4, side)))

// Side stripes
material(neon, paint(#0B6B8F, move(0, 1.8, 1.52, cube(3.5, 0.08, 0.02)), move(0, 2.1, 1.52, cube(3.5, 0.08, 0.02)),
                              move(0, 1.8, -1.52, cube(3.5, 0.08, 0.02)), move(0, 2.1, -1.52, cube(3.5, 0.08, 0.02))))

// Control shelf, kick plate and marquee
material(plastic, paint(#17112B, move(0.75, 3.55, 0, rotateZ(12, cube(1.5, 0.28, 2.6)))))
paint(#120D22, move(0.87, 1.7, 0, cube(0.1, 3.4, 2.6)))
material(neon, paint(#8F2E06, move(1.05, 7.0, 0, cube(0.12, 0.8, 2.5))))
paint(#120D22, move(0.8, 7.45, 0, cube(1.2, 0.14, 2.7)), move(0.8, 6.55, 0, cube(1.2, 0.14, 2.7)))

// Coin door
paint(#3A3550, move(0.95, 1.8, 0, cube(0.06, 1.3, 1.1)))
material(neon, paint(#8F0A08, move(1.0, 2.05, 0.25, cube(0.04, 0.32, 0.08)), move(1.0, 2.05, -0.25, cube(0.04, 0.32, 0.08))))

// ── Joystick and buttons ───────────────────────────────
material(metal, paint(#AAB2BA, move(0.75, 3.95, 0.7, cylinder(0.05, 0.5))))
material(plastic, paint(#FF3030, move(0.75, 4.22, 0.7, sphere(0.16))))
button = cylinder(0.12, 0.08)
material(neon, paint(#8F5C11, move(0.72, 3.75, -0.25, button)))
material(neon, paint(#106B22, move(0.72, 3.75, -0.65, button)))
material(neon, paint(#0B6B8F, move(0.72, 3.75, -1.05, button)))

// ── Screen: everything below sits on one tilted plane ──
screen = paint(#050810, cube(0.1, 2.3, 2.3))

px = 0.13
pixelBar = cube(0.06, px, 1)
anvilArt = group(move(0, 0.3, 0.05, cube(0.06, px * 2, px * 9)),
                 move(0, 0.34, -0.72, cube(0.06, px, px * 3)),
                 move(0, 0.05, 0.05, cube(0.06, px, px * 5)),
                 move(0, -0.1, 0.05, cube(0.06, px, px * 3)),
                 move(0, -0.25, 0.05, cube(0.06, px, px * 3)),
                 move(0, -0.42, 0.05, cube(0.06, px * 2, px * 7)))
sparks = group(move(0, 0.72, 0.4, cube(0.06, px, px)), move(0, 0.62, -0.1, cube(0.06, px, px)), move(0, 0.82, -0.5, cube(0.06, px, px)))
score = group(move(0, -0.92, 0.75, cube(0.06, 0.09, 0.42)), move(0, -0.92, 0.2, cube(0.06, 0.09, 0.42)), move(0, -0.92, -0.75, cube(0.06, 0.09, 0.42)))

panel = group(screen,
              material(neon, paint(#8F2E06, move(0.05, 0, 0, anvilArt))),
              material(neon, paint(#8F5C11, move(0.05, 0, 0, sparks))),
              material(neon, paint(#0B6B8F, move(0.05, 0, 0, score))))
move(0.98, 5.25, 0, rotateZ(-12, panel))

