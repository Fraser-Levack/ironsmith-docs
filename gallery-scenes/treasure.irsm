// An open treasure chest, made for the pixel_art filter.
// With only 16 colours and chunky pixels, big blocky parts and colours close to
// the palette (wood, gold, gem red and blue) keep their shape and read cleanly.
// Faces +X, ground at y = 0.

light(1, 1.3, 0.7, 1.15)

// A dark backdrop: the hole on the light's side stops the shell shadowing the scene.
material(neon, paint(#000000, difference(difference(sphere(24), sphere(23.6)), move(11, 14.3, 7.7, sphere(14)))))

// ── Chest ──────────────────────────────────────────────
base = move(0, 1.25, 0, difference(cube(3.4, 2.5, 5), move(0, 0.4, 0, cube(2.8, 2.5, 4.4))))
paint(#6E3E1E, base)

// The lid is built closed with its hinge at the origin, then swung open.
lidOuter = intersection(rotateX(90, cylinder(1.7, 5)), move(0, 1, 0, cube(4, 2, 6)))
lidShell = difference(lidOuter, rotateX(90, cylinder(1.4, 4.4)))
lidBands = group(move(0, 0, 1.6, rotateX(90, cylinder(1.77, 0.36))), move(0, 0, -1.6, rotateX(90, cylinder(1.77, 0.36))))
bandHalf = intersection(difference(lidBands, rotateX(90, cylinder(1.5, 6))), move(0, 1, 0, cube(4, 2, 6)))

hingeX = -1.7
hingeY = 2.5
openAngle = -108
paint(#6E3E1E, move(hingeX, hingeY, 0, rotateZ(openAngle, move(1.7, 0, 0, lidShell))))
material(plastic, paint(#D9A322, move(hingeX, hingeY, 0, rotateZ(openAngle, move(1.7, 0, 0, bandHalf)))))

// Gold bands and the lock on the base
material(plastic, paint(#D9A322, move(0, 1.25, 1.6, cube(3.52, 2.56, 0.36)), move(0, 1.25, -1.6, cube(3.52, 2.56, 0.36)),
                        move(0, 2.42, 0, cube(3.5, 0.2, 5.1)), move(1.76, 1.9, 0, cube(0.2, 0.9, 0.8))))
paint(#2A1A10, move(1.88, 1.85, 0, cube(0.1, 0.3, 0.2)))

// ── Treasure ───────────────────────────────────────────
material(plastic, paint(#EDBB2C, move(0, 2.55, 0, scale(1.32, 0.72, 2.12, sphere(1)))))

coin = cylinder(0.3, 0.07)
material(plastic, paint(#F7D64E, move(0.7, 3.2, 0.9, rotateZ(25, coin)), move(-0.2, 3.3, -1.0, rotateX(30, coin)), move(0.9, 3.05, -0.8, rotateZ(-20, coin)),
                        move(-0.5, 3.28, 0.7, rotateX(-25, coin)), move(0.2, 3.4, 0.1, rotateZ(40, coin)),
                        move(2.5, 0.04, 1.2, coin), move(3.1, 0.04, 0.3, coin), move(2.7, 0.11, 0.5, rotateZ(8, coin)),
                        move(3.4, 0.04, -1.1, coin), move(2.4, 0.04, -1.6, coin)))

gem = rotateY(45, rotateX(35, cube(0.62, 0.62, 0.62)))
material(plastic, paint(#C81E2C, move(0.5, 3.45, -0.15, gem), move(2.9, 0.34, -0.4, scale(0.8, gem))))
material(plastic, paint(#2456C8, move(-0.4, 3.45, 1.2, gem), move(3.4, 0.3, 1.2, scale(0.7, gem))))
material(plastic, paint(#2FA05A, move(-0.1, 3.5, -1.5, scale(0.9, gem))))

// ── Stone floor, with dark seams between the slabs ─────
paint(#57525E, move(0, -0.25, 0, cylinder(9, 0.5)))
seams = group(repeat(2.5, 0, 0, cube(0.1, 1, 30)), repeat(0, 0, 2.5, cube(30, 1, 0.1)))
paint(#2C2933, intersection(seams, move(0, -0.25, 0, cylinder(9.01, 0.52))))
