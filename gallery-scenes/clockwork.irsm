// A clockwork gear train on a riveted plate, made for the edge_detection filter.
// That filter traces changes in brightness, so every part is a crisp hard edge
// and neighbouring parts use different tones.
// All the gears share one tooth size (module 0.5), so they really mesh.

light(0.7, 1.5, 0.45, 1.1)

// A black backdrop, so the outlines stand alone. The hole on the light's side stops it shadowing the scene.
material(neon, paint(#000000, difference(difference(sphere(34), sphere(33.6)), move(13, 27.8, 8.4, sphere(22)))))

h = 1.2
toothW = 0.72
bar = cube(40, h, toothW)

// Each bar makes two opposite teeth; a teeth set is trimmed to the tip circle below.
teeth12 = group(bar, rotateY(30, bar), rotateY(60, bar), rotateY(90, bar), rotateY(120, bar), rotateY(150, bar))
teeth24 = group(teeth12, rotateY(15, teeth12))
teeth16 = group(bar, rotateY(22.5, bar), rotateY(45, bar), rotateY(67.5, bar),
                rotateY(90, bar), rotateY(112.5, bar), rotateY(135, bar), rotateY(157.5, bar))

// ── Parts ──────────────────────────────────────────────
bolt = move(0, h / 2 + 0.08, 0, cylinder(0.26, 0.2))
axle = group(cylinder(0.55, h + 1.3), move(0, h / 2 + 0.72, 0, cylinder(0.85, 0.16)))

// A spoked window ring cut through a gear
spokes6 = group(cube(30, h + 2, 0.8), rotateY(60, cube(30, h + 2, 0.8)), rotateY(120, cube(30, h + 2, 0.8)))
spokes4 = group(cube(30, h + 2, 0.7), rotateY(90, cube(30, h + 2, 0.7)))
windows24 = difference(difference(cylinder(4.5, h + 1), cylinder(1.9, h + 1)), spokes6)
windows16 = difference(difference(cylinder(2.8, h + 1), cylinder(1.25, h + 1)), spokes4)

// ── Gears (pitch radius = teeth x 0.25) ───────────────
gear24 = difference(group(cylinder(5.72, h), intersection(teeth24, cylinder(6.32, h))), windows24)
gear16 = difference(group(cylinder(3.72, h), intersection(teeth16, cylinder(4.32, h))), windows16)
gear12 = group(cylinder(2.72, h), intersection(teeth12, cylinder(3.32, h)))

bolts6 = group(move(1.75, 0, 0, bolt), move(-1.75, 0, 0, bolt), rotateY(60, group(move(1.75, 0, 0, bolt), move(-1.75, 0, 0, bolt))),
               rotateY(120, group(move(1.75, 0, 0, bolt), move(-1.75, 0, 0, bolt))))

// ── Layout: the big gear at A; B and C mesh with it ───
gearY = 0.8
ax = -3.5
az = 1.5
bx = ax + 9 * 0.866
bz = az + 9 * 0.5
cx = ax + 10 * 0.5
cz = az - 10 * 0.866

// B's and C's turn puts a gap, not a tooth, on the line to the big gear.
bGear = move(bx, gearY, bz, rotateY(15, gear12))
cGear = move(cx, gearY, cz, rotateY(18.75, gear16))
aGear = move(ax, gearY, az, rotateY(30, gear24))

// D also meshes with the big gear, and E with B.
dx = ax - 9 * 0.866
dz = az + 9 * 0.5
ex = bx + 7 * 0.5
ez = bz - 7 * 0.866
dGear = move(dx, gearY, dz, rotateY(15, gear12))
eGear = move(ex, gearY, ez, rotateY(7.5, gear16))

material(plastic, paint(#C49A52, aGear))
material(plastic, paint(#98A0AA, bGear))
material(plastic, paint(#B86C3E, cGear))
material(plastic, paint(#7F8A6A, dGear))
material(plastic, paint(#A9825C, eGear))

// A smaller pinion stacked on the big gear's axle, for depth
material(plastic, paint(#D8D2C0, move(ax, gearY + h, az, rotateY(7.5, scale(0.72, gear12)))))
paint(#6B7078, move(ax, gearY + 0.6, az, axle), move(bx, gearY, bz, axle), move(cx, gearY, cz, axle),
      move(dx, gearY, dz, axle), move(ex, gearY, ez, axle))
paint(#E2DED0, move(bx, gearY, bz, bolts6))

// ── Plate ──────────────────────────────────────────────
paint(#3A3F46, move(0, -0.5, 0, cube(31, 1, 29)))
paint(#262A2F, move(0, -1.2, 0, cube(33, 0.6, 31)))

railZ = group(move(0, 0, 13.4, cube(29, 2, 1)), move(0, 0, -13.4, cube(29, 2, 1)))
railX = group(move(14.4, 0, 0, cube(1, 2, 27)), move(-14.4, 0, 0, cube(1, 2, 27)))
rivets = repeat(2.4, 0, 2.4, cylinder(0.3, 0.3))
paint(#B7BCC4, move(0, 0.1, 0, intersection(rivets, group(railZ, railX))))
